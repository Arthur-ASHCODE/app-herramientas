
# ======================================================
# .HTACCESS PRINCIPAL - APP-BASE
# ======================================================

RewriteEngine On

# ------------------------------------------------------
# 1. EVITAR REESCRITURAS REPETIDAS
# ------------------------------------------------------

# Si la solicitud ya corresponde al directorio public,
# no volver a agregar public/ al inicio.

RewriteRule ^public(?:/|$) - [L]


# ------------------------------------------------------
# 2. DIRIGIR LAS SOLICITUDES AL DIRECTORIO PUBLIC
# ------------------------------------------------------

# Todas las demás solicitudes se reescriben
# internamente hacia la carpeta public.

RewriteRule ^(.*)$ public/$1 [L]
